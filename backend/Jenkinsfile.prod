pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        choice(
            name: 'DEPLOYMENT_MODE',
            choices: ['validation', 'production'],
            description: 'validation은 18080/18443 임시 검증까지만, production은 80/443 실제 카나리 배포까지 수행'
        )
        string(
            name: 'CURRENT_STABLE_REVISION',
            defaultValue: '',
            description: '최초 전환 시 기존 운영 이미지의 Git SHA (이후 배포에서는 자동 감지)'
        )
    }

    environment {
        COMPOSE_FILE = 'docker-compose.prod.yml'
        IMAGE_REPOSITORY = 'wecandoit-backend-prod'
        NGINX_IMAGE_REPOSITORY = 'wecandoit-nginx-prod'
        NGINX_CONTAINER = 'wecandoit-nginx-prod'
        STABLE_CONTAINER = 'wecandoit-backend-stable'
        CANARY_CONTAINER = 'wecandoit-backend-canary'
        LEGACY_STABLE_CONTAINER = 'wecandoit-backend-prod'
        EDGE_NETWORK = 'wecandoit-edge'
        STABLE_BIND_ADDRESS = '127.0.0.1'
        STABLE_HOST_PORT = '8080'
        CANARY_HOST_PORT = '8082'
        BACKEND_SERVICE_PORT = '8080'
        NGINX_SMOKE_PORT = '8088'
        MANAGEMENT_PORT = '9091'
        PRODUCTION_DOMAIN = 'i15a506.p.ssafy.io'
        CANARY_OBSERVATION_SECONDS = '60'
        CANARY_MIN_REQUESTS = '1'
        CANARY_MAX_5XX_RATE = '1.0'
        CANARY_MAX_AVG_RESPONSE_TIME = '1.0'
        CANARY_MAX_RESPONSE_TIME = '3.0'
        DEPLOYMENT_PHASE = 'preflight'
    }

    stages {
        stage('Check Backend Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: '''
                        if git rev-parse HEAD~1 >/dev/null 2>&1; then
                          git diff --name-only HEAD~1 HEAD
                        else
                          echo "backend/"
                        fi
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def hasBackendChanges = changedFiles
                        .split('\\n')
                        .any { it.startsWith('backend/') }

                    if (!hasBackendChanges) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No backend changes. Skip backend production CD.')
                    }
                }
            }
        }

        stage('Preflight') {
            steps {
                dir('backend') {
                    script {
                        env.GIT_SHA = sh(
                            script: 'git rev-parse --short=12 HEAD',
                            returnStdout: true
                        ).trim()

                        env.NGINX_CANDIDATE_IMAGE = "${env.NGINX_IMAGE_REPOSITORY}:${env.GIT_SHA}"
                        env.STABLE_HEALTH_URL = "http://127.0.0.1:${env.MANAGEMENT_PORT}/actuator/health"
                        env.CANARY_HEALTH_URL = "http://127.0.0.1:${env.MANAGEMENT_PORT}/actuator/health"
                        env.NGINX_ROUTED_SMOKE_URL = "http://127.0.0.1:${env.NGINX_SMOKE_PORT}/v3/api-docs"
                        env.SERVICE_SMOKE_URL = "https://${env.PRODUCTION_DOMAIN}/v3/api-docs"
                        if (params.DEPLOYMENT_MODE == 'production') {
                            env.NGINX_BIND_ADDRESS = '0.0.0.0'
                            env.NGINX_HTTP_PORT = '80'
                            env.NGINX_HTTPS_PORT = '443'
                        } else {
                            env.NGINX_BIND_ADDRESS = '127.0.0.1'
                            env.NGINX_HTTP_PORT = '18080'
                            env.NGINX_HTTPS_PORT = '18443'
                        }

                        env.ROLLBACK_IMAGE = sh(
                            script: '''
                            set -eu

                            command -v docker >/dev/null
                            command -v curl >/dev/null
                            command -v awk >/dev/null
                            docker compose version >/dev/null

                            network_state=$(docker network inspect --format \
                              '{{.Driver}} {{.Scope}} {{.Internal}}' "$EDGE_NETWORK" 2>/dev/null) || {
                              echo "$EDGE_NETWORK Docker network is required before deployment." >&2
                              exit 1
                            }
                            if [ "$network_state" != 'bridge local false' ]; then
                              echo "$EDGE_NETWORK must be a non-internal local bridge network: $network_state" >&2
                              exit 1
                            fi

                            if [ "$DEPLOYMENT_MODE" = 'validation' ] \
                              && [ "$(docker inspect --format '{{.State.Running}}' \
                                "$NGINX_CONTAINER" 2>/dev/null)" = 'true' ] \
                              && { ! docker port "$NGINX_CONTAINER" 80/tcp \
                                  | grep -qx "$NGINX_BIND_ADDRESS:$NGINX_HTTP_PORT" \
                                || ! docker port "$NGINX_CONTAINER" 443/tcp \
                                  | grep -qx "$NGINX_BIND_ADDRESS:$NGINX_HTTPS_PORT"; }; then
                              echo "Validation mode cannot replace a running production-port Docker Nginx." >&2
                              echo "Use production mode for deployments after the 80/443 cutover." >&2
                              exit 1
                            fi

                            for published_port in "$NGINX_HTTP_PORT" "$NGINX_HTTPS_PORT"; do
                              port_owner=$(docker ps \
                                --filter "publish=$published_port" \
                                --format '{{.Names}}' \
                                | grep -vx "$NGINX_CONTAINER" \
                                | head -n 1 || true)
                              if [ -n "$port_owner" ]; then
                                echo "Nginx port $published_port is already published by $port_owner." >&2
                                exit 1
                              fi
                            done

                            canary_port_owner=$(docker ps \
                              --filter "publish=$CANARY_HOST_PORT" \
                              --format '{{.Names}}' \
                              | head -n 1)
                            if [ -n "$canary_port_owner" ] \
                              && [ "$canary_port_owner" != "$CANARY_CONTAINER" ]; then
                              echo "Port $CANARY_HOST_PORT is already published by $canary_port_owner." >&2
                              exit 1
                            fi

                            is_running_stable() {
                              container_name="$1"
                              [ "$(docker inspect --format '{{.State.Running}}' \
                                "$container_name" 2>/dev/null)" = "true" ] \
                                && docker port "$container_name" "$BACKEND_SERVICE_PORT/tcp" \
                                  | grep -qx "$STABLE_BIND_ADDRESS:$STABLE_HOST_PORT"
                            }

                            current_container=""
                            current_image_id=""
                            if is_running_stable "$STABLE_CONTAINER"; then
                              current_container="$STABLE_CONTAINER"
                              current_image_id=$(docker inspect \
                                --format '{{.Image}}' "$STABLE_CONTAINER")
                            elif is_running_stable "$LEGACY_STABLE_CONTAINER"; then
                              current_container="$LEGACY_STABLE_CONTAINER"
                              current_image_id=$(docker inspect \
                                --format '{{.Image}}' "$LEGACY_STABLE_CONTAINER")
                            else
                              echo "A running production container mapped to $STABLE_BIND_ADDRESS:$STABLE_HOST_PORT is required." >&2
                              exit 1
                            fi

                            HEALTH_CHECK_CONTAINER="$current_container" \
                              bash infra/deploy/check-backend-health.sh \
                                "$STABLE_HEALTH_URL" 5 2 >&2

                            revision=$(docker image inspect \
                              --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
                              "$current_image_id" 2>/dev/null || true)

                            case "$revision" in
                              ""|"<no value>"|"unknown")
                                if ! printf '%s' "$CURRENT_STABLE_REVISION" \
                                  | grep -Eq '^[0-9a-fA-F]{7,40}$'; then
                                  echo "CURRENT_STABLE_REVISION must contain the deployed Git SHA." >&2
                                  exit 1
                                fi
                                preserve_tag="$CURRENT_STABLE_REVISION"
                                ;;
                              *)
                                preserve_tag="$revision"
                                ;;
                            esac

                            docker image tag "$current_image_id" "$IMAGE_REPOSITORY:$preserve_tag"
                            docker image tag "$current_image_id" "$IMAGE_REPOSITORY:stable"
                            printf '%s:%s' "$IMAGE_REPOSITORY" "$preserve_tag"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.NGINX_ROLLBACK_IMAGE = sh(
                            script: '''
                            set -eu

                            if [ "$(docker inspect --format '{{.State.Running}}' \
                              "$NGINX_CONTAINER" 2>/dev/null)" = 'true' ]; then
                              current_nginx_image_id=$(docker inspect \
                                --format '{{.Image}}' "$NGINX_CONTAINER")
                              rollback_nginx_image="$NGINX_IMAGE_REPOSITORY:rollback"
                              docker image tag "$current_nginx_image_id" "$rollback_nginx_image"
                              printf '%s' "$rollback_nginx_image"
                            fi
                            ''',
                            returnStdout: true
                        ).trim()
                    }

                    echo "Current production image preserved as ${env.ROLLBACK_IMAGE} and ${env.IMAGE_REPOSITORY}:stable"
                    if (env.NGINX_ROLLBACK_IMAGE) {
                        echo "Current Nginx image preserved as ${env.NGINX_ROLLBACK_IMAGE}"
                    } else {
                        echo 'No running Docker Nginx image exists to preserve.'
                    }
                }
            }
        }

        stage('Build and Test') {
            steps {
                dir('backend') {
                    sh '''
                    set -eu
                    chmod +x gradlew
                    ./gradlew clean test bootJar
                    docker build \
                      --build-arg GIT_COMMIT="$GIT_SHA" \
                      --tag "$IMAGE_REPOSITORY:$GIT_SHA" \
                      --tag "$IMAGE_REPOSITORY:canary" \
                      .
                    docker build \
                      --tag "$NGINX_CANDIDATE_IMAGE" \
                      infra/nginx
                    bash infra/deploy/validate-nginx-image.sh "$NGINX_CANDIDATE_IMAGE"

                    expected_http_mapping="$NGINX_BIND_ADDRESS:$NGINX_HTTP_PORT"
                    expected_https_mapping="$NGINX_BIND_ADDRESS:$NGINX_HTTPS_PORT"
                    if [ "$(docker inspect --format '{{.State.Running}}' \
                      "$NGINX_CONTAINER" 2>/dev/null)" != 'true' ] \
                      || ! docker port "$NGINX_CONTAINER" 80/tcp 2>/dev/null \
                        | grep -qx "$expected_http_mapping" \
                      || ! docker port "$NGINX_CONTAINER" 443/tcp 2>/dev/null \
                        | grep -qx "$expected_https_mapping"; then
                      port_probe="wecandoit-nginx-port-check-$GIT_SHA"
                      docker rm -f "$port_probe" >/dev/null 2>&1 || true
                      trap 'docker rm -f "$port_probe" >/dev/null 2>&1 || true' EXIT
                      docker run --detach \
                        --name "$port_probe" \
                        --publish "$NGINX_BIND_ADDRESS:$NGINX_HTTP_PORT:80" \
                        --publish "$NGINX_BIND_ADDRESS:$NGINX_HTTPS_PORT:443" \
                        --entrypoint /bin/sh \
                        "$NGINX_CANDIDATE_IMAGE" -c 'sleep 30' >/dev/null
                      [ "$(docker inspect --format '{{.State.Running}}' \
                        "$port_probe")" = 'true' ]
                      docker rm -f "$port_probe" >/dev/null
                      trap - EXIT
                    fi
                    '''
                }
            }
        }

        stage('Start Stable') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        STABLE_IMAGE="$ROLLBACK_IMAGE" \
                        CANARY_IMAGE="$IMAGE_REPOSITORY:$GIT_SHA" \
                        NGINX_IMAGE="$NGINX_CANDIDATE_IMAGE" \
                        NGINX_BIND_ADDRESS="$NGINX_BIND_ADDRESS" \
                        NGINX_HTTP_PORT="$NGINX_HTTP_PORT" \
                        NGINX_HTTPS_PORT="$NGINX_HTTPS_PORT" \
                          docker compose -f "$COMPOSE_FILE" config --quiet

                        docker compose -f "$COMPOSE_FILE" up -d mysql redis

                        if docker inspect "$LEGACY_STABLE_CONTAINER" >/dev/null 2>&1; then
                          docker stop "$LEGACY_STABLE_CONTAINER"
                          docker rm "$LEGACY_STABLE_CONTAINER"
                        fi

                        STABLE_IMAGE="$ROLLBACK_IMAGE" \
                          docker compose -f "$COMPOSE_FILE" up -d --no-deps backend-stable
                        HEALTH_CHECK_CONTAINER="$STABLE_CONTAINER" \
                          bash infra/deploy/check-backend-health.sh "$STABLE_HEALTH_URL"
                        '''
                    }
                }
                script {
                    env.DEPLOYMENT_PHASE = 'stable-ready'
                }
            }
        }

        stage('Start Nginx') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        NGINX_IMAGE="$NGINX_CANDIDATE_IMAGE" \
                        NGINX_BIND_ADDRESS="$NGINX_BIND_ADDRESS" \
                        NGINX_HTTP_PORT="$NGINX_HTTP_PORT" \
                        NGINX_HTTPS_PORT="$NGINX_HTTPS_PORT" \
                          docker compose -f "$COMPOSE_FILE" up -d --no-deps nginx

                        running_nginx_image_id=$(docker inspect \
                          --format '{{.Image}}' "$NGINX_CONTAINER")
                        candidate_nginx_image_id=$(docker image inspect \
                          --format '{{.Id}}' "$NGINX_CANDIDATE_IMAGE")
                        if [ "$running_nginx_image_id" != "$candidate_nginx_image_id" ]; then
                          echo "Running Nginx does not use the validated candidate image." >&2
                          exit 1
                        fi

                        docker port "$NGINX_CONTAINER" 80/tcp \
                          | grep -qx "$NGINX_BIND_ADDRESS:$NGINX_HTTP_PORT"
                        docker port "$NGINX_CONTAINER" 443/tcp \
                          | grep -qx "$NGINX_BIND_ADDRESS:$NGINX_HTTPS_PORT"
                        docker exec "$NGINX_CONTAINER" nginx -t
                        bash infra/deploy/apply-backend-route.sh stable-only
                        docker image tag "$NGINX_CANDIDATE_IMAGE" \
                          "$NGINX_IMAGE_REPOSITORY:latest"
                        '''
                    }
                }
            }
        }

        stage('Deploy Canary') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        CANARY_IMAGE="$IMAGE_REPOSITORY:$GIT_SHA" \
                          docker compose -f "$COMPOSE_FILE" up -d --no-deps --force-recreate backend-canary

                        if ! HEALTH_CHECK_CONTAINER="$CANARY_CONTAINER" \
                          bash infra/deploy/check-backend-health.sh "$CANARY_HEALTH_URL"; then
                          docker compose -f "$COMPOSE_FILE" stop backend-canary
                          docker compose -f "$COMPOSE_FILE" rm -f backend-canary
                          exit 1
                        fi
                        '''
                    }
                }
                script {
                    env.DEPLOYMENT_PHASE = 'canary-ready'
                }
            }
        }

        stage('Complete Temporary Validation') {
            when {
                expression { params.DEPLOYMENT_MODE == 'validation' }
            }
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        bash infra/deploy/apply-backend-route.sh stable-only
                        docker compose -f "$COMPOSE_FILE" stop backend-canary
                        docker compose -f "$COMPOSE_FILE" rm -f backend-canary
                        '''
                    }
                }
                script {
                    env.DEPLOYMENT_PHASE = 'completed'
                }
            }
        }

        stage('Prepare Stable Routing and Rollback') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            steps {
                dir('backend') {
                    sh '''
                    set -eu
                    bash infra/deploy/apply-backend-route.sh \
                      stable-only "$SERVICE_SMOKE_URL"
                    '''
                }
            }
        }

        stage('Route Canary 10%') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            steps {
                script {
                    env.CANARY_MONITOR_STARTED_AT = sh(
                        script: 'date -u +%Y-%m-%dT%H:%M:%SZ',
                        returnStdout: true
                    ).trim()
                }
                dir('backend') {
                    sh '''
                    set -eu
                    bash infra/deploy/apply-backend-route.sh \
                      canary-10 "$SERVICE_SMOKE_URL"
                    '''
                }
                script {
                    env.DEPLOYMENT_PHASE = 'canary-10'
                }
            }
        }

        stage('Check Canary Monitoring') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            steps {
                dir('backend') {
                    sh '''
                    set -eu
                    monitoring_log=$(mktemp)
                    trap 'rm -f "$monitoring_log"' EXIT
                    sleep "$CANARY_OBSERVATION_SECONDS"

                    if [ "$(docker inspect --format '{{.State.Running}}' \
                      "$CANARY_CONTAINER" 2>/dev/null)" != "true" ]; then
                      echo "Canary container is not running." >&2
                      exit 1
                    fi

                    HEALTH_CHECK_CONTAINER="$CANARY_CONTAINER" \
                      bash infra/deploy/check-backend-health.sh \
                        "$CANARY_HEALTH_URL" 5 2

                    docker logs --since "$CANARY_MONITOR_STARTED_AT" \
                      "$NGINX_CONTAINER" > "$monitoring_log" 2>&1

                    canary_ip=$(docker inspect --format \
                      "{{with index .NetworkSettings.Networks \"$EDGE_NETWORK\"}}{{.IPAddress}}{{end}}" \
                      "$CANARY_CONTAINER")
                    if [ -z "$canary_ip" ]; then
                      echo "Canary is not connected to the $EDGE_NETWORK network." >&2
                      exit 1
                    fi

                    bash infra/deploy/check-canary-monitoring.sh \
                      "$canary_ip:$BACKEND_SERVICE_PORT" \
                      "$CANARY_MIN_REQUESTS" \
                      "$CANARY_MAX_5XX_RATE" \
                      "$CANARY_MAX_AVG_RESPONSE_TIME" \
                      "$CANARY_MAX_RESPONSE_TIME" < "$monitoring_log"

                    container_logs=$(docker logs \
                      --since "$CANARY_MONITOR_STARTED_AT" \
                      "$CANARY_CONTAINER" 2>&1)

                    if printf '%s\n' "$container_logs" | grep -E 'ERROR|Exception'; then
                      echo "Canary container error logs were detected." >&2
                      exit 1
                    fi

                    echo "No Canary container ERROR or Exception logs were detected."
                    '''
                }
            }
        }

        stage('Approve Canary 100%') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                input(
                    message: 'Canary 5xx ≤ 1%, 평균 응답 ≤ 1초, 최대 응답 ≤ 3초, 컨테이너 오류 없음이 확인됐습니까?',
                    ok: 'Canary 100% 전환'
                )
            }
        }

        stage('Route Canary 100%') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            steps {
                dir('backend') {
                    sh '''
                    set -eu
                    bash infra/deploy/apply-backend-route.sh \
                      canary-only "$SERVICE_SMOKE_URL"
                    '''
                }
                script {
                    env.DEPLOYMENT_PHASE = 'canary-only'
                }
            }
        }

        stage('Approve Stable Promotion') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                input(
                    message: 'Canary 100% 모니터링 결과가 정상입니까?',
                    ok: 'Stable 승격'
                )
            }
        }

        stage('Promote Stable') {
            when {
                expression { params.DEPLOYMENT_MODE == 'production' }
            }
            steps {
                script {
                    env.DEPLOYMENT_PHASE = 'stable-promoting'
                }
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        docker image tag "$IMAGE_REPOSITORY:$GIT_SHA" "$IMAGE_REPOSITORY:stable"
                        STABLE_IMAGE="$IMAGE_REPOSITORY:stable" \
                          docker compose -f "$COMPOSE_FILE" up \
                            -d --no-deps --force-recreate backend-stable
                        HEALTH_CHECK_CONTAINER="$STABLE_CONTAINER" \
                          bash infra/deploy/check-backend-health.sh "$STABLE_HEALTH_URL"

                        bash infra/deploy/apply-backend-route.sh \
                          stable-only "$SERVICE_SMOKE_URL"
                        '''
                    }
                }
                script {
                    env.DEPLOYMENT_PHASE = 'stable-promoted'
                }
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        sh '''
                        set -eu
                        docker compose -f "$COMPOSE_FILE" stop backend-canary
                        docker compose -f "$COMPOSE_FILE" rm -f backend-canary
                        '''
                    }
                }
                script {
                    env.DEPLOYMENT_PHASE = 'completed'
                }
            }
        }
    }

    post {
        success {
            script {
                if (params.DEPLOYMENT_MODE == 'production') {
                    echo "Production Canary CD completed successfully. Stable image: ${env.IMAGE_REPOSITORY}:${env.GIT_SHA}"
                } else {
                    echo "Temporary Docker Nginx and Canary validation completed successfully. Candidate image: ${env.IMAGE_REPOSITORY}:${env.GIT_SHA}"
                }
            }
        }
        unsuccessful {
            dir('backend') {
                withCredentials([
                    string(credentialsId: 'prod-db-password', variable: 'DB_PASSWORD'),
                    string(credentialsId: 'prod-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                    string(credentialsId: 'prod-jwt-secret', variable: 'JWT_SECRET')
                ]) {
                    sh '''
                    set +e

                    if [ -n "${ROLLBACK_IMAGE:-}" ]; then
                      is_running_stable() {
                        container_name="$1"
                        [ "$(docker inspect --format '{{.State.Running}}' \
                          "$container_name" 2>/dev/null)" = "true" ] \
                          && docker port "$container_name" "$BACKEND_SERVICE_PORT/tcp" \
                            | grep -qx "$STABLE_BIND_ADDRESS:$STABLE_HOST_PORT"
                      }

                      is_nginx_running() {
                        [ "$(docker inspect --format '{{.State.Running}}' \
                          "$NGINX_CONTAINER" 2>/dev/null)" = 'true' ]
                      }

                      restore_nginx_image() {
                        if [ -z "${NGINX_ROLLBACK_IMAGE:-}" ]; then
                          echo "No previous Docker Nginx image is available." >&2
                          return 1
                        fi

                        echo "Restoring Nginx from $NGINX_ROLLBACK_IMAGE."
                        NGINX_IMAGE="$NGINX_ROLLBACK_IMAGE" \
                        NGINX_BIND_ADDRESS="$NGINX_BIND_ADDRESS" \
                        NGINX_HTTP_PORT="$NGINX_HTTP_PORT" \
                        NGINX_HTTPS_PORT="$NGINX_HTTPS_PORT" \
                          docker compose -f "$COMPOSE_FILE" up \
                            -d --no-deps --force-recreate nginx || return 1

                        rollback_nginx_image_id=$(docker image inspect \
                          --format '{{.Id}}' "$NGINX_ROLLBACK_IMAGE" 2>/dev/null)
                        running_nginx_image_id=$(docker inspect \
                          --format '{{.Image}}' "$NGINX_CONTAINER" 2>/dev/null)

                        is_nginx_running \
                          && [ "$running_nginx_image_id" = "$rollback_nginx_image_id" ] \
                          && docker exec "$NGINX_CONTAINER" nginx -t
                      }

                      route_stable_with_nginx() {
                        if is_nginx_running \
                          && bash infra/deploy/apply-backend-route.sh stable-only; then
                          return 0
                        fi

                        echo "Current Nginx could not restore Stable routing. Trying the preserved image." >&2
                        restore_nginx_image \
                          && bash infra/deploy/apply-backend-route.sh stable-only
                      }

                      rollback_image_id=$(docker image inspect \
                        --format '{{.Id}}' "$ROLLBACK_IMAGE" 2>/dev/null)
                      stable_ready=false

                      for container_name in "$STABLE_CONTAINER" "$LEGACY_STABLE_CONTAINER"; do
                        if is_running_stable "$container_name"; then
                          running_image_id=$(docker inspect \
                            --format '{{.Image}}' "$container_name")
                          if [ "$running_image_id" = "$rollback_image_id" ] \
                            && HEALTH_CHECK_CONTAINER="$container_name" \
                              bash infra/deploy/check-backend-health.sh \
                                "$STABLE_HEALTH_URL" 5 2; then
                            stable_ready=true
                            echo "Stable already uses the healthy rollback image. Skipping container recreation."
                            break
                          fi
                        fi
                      done

                      if [ "$stable_ready" != true ]; then
                        case "${DEPLOYMENT_PHASE:-preflight}" in
                          stable-promoted|completed)
                            if is_running_stable "$STABLE_CONTAINER" \
                              && HEALTH_CHECK_CONTAINER="$STABLE_CONTAINER" \
                                bash infra/deploy/check-backend-health.sh \
                                  "$STABLE_HEALTH_URL" 5 2; then
                              echo "Promoted Stable is healthy. Skipping rollback image restore."
                              stable_ready=true
                            fi
                            ;;
                        esac
                      fi

                      if [ "$stable_ready" != true ]; then
                        echo "Restoring Stable from $ROLLBACK_IMAGE."
                        STABLE_IMAGE="$ROLLBACK_IMAGE" \
                          docker compose -f "$COMPOSE_FILE" up \
                            -d --no-deps --force-recreate backend-stable

                        restored_image_id=$(docker inspect \
                          --format '{{.Image}}' "$STABLE_CONTAINER" 2>/dev/null)
                        if is_running_stable "$STABLE_CONTAINER" \
                          && [ "$restored_image_id" = "$rollback_image_id" ] \
                          && HEALTH_CHECK_CONTAINER="$STABLE_CONTAINER" \
                            bash infra/deploy/check-backend-health.sh \
                              "$STABLE_HEALTH_URL" 15 2; then
                          stable_ready=true
                        fi
                      fi

                      if [ "$stable_ready" = true ]; then
                        if route_stable_with_nginx; then
                          docker compose -f "$COMPOSE_FILE" stop backend-canary
                          docker compose -f "$COMPOSE_FILE" rm -f backend-canary
                        else
                          echo "Nginx rollback failed. Canary was left running."
                        fi
                      else
                        echo "Stable rollback is unavailable. Canary and Nginx routing were left unchanged."
                      fi
                    fi
                    '''
                }
            }
        }
    }
}
