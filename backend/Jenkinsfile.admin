pipeline {
    agent { label 'deploy-admin' }

    environment {
        ADMIN_ROOT = '/var/www/wecandoit-admin'
        ADMIN_PROD_HOST = 'https://i15a506.p.ssafy.io/admin-ui/'
        ADMIN_DEV_HOST = 'https://i15a506.p.ssafy.io/dev/admin-ui/'
    }

    stages {

        stage('Build Admin') {
            steps {
                dir('frontend/admin') {
                    sh '''
                    node --version
                    npm ci
                    npm run lint
                    rm -rf dist-prod dist-dev
                    VITE_API_ENV=prod VITE_API_BASE_URL=https://i15a506.p.ssafy.io npm run build
                    mv dist dist-prod
                    VITE_API_ENV=dev VITE_API_BASE_URL=https://i15a506.p.ssafy.io/dev npm run build
                    mv dist dist-dev
                    '''
                }
            }
        }

        stage('Release Admin') {
            steps {
                sh '''
                prod_release="$ADMIN_ROOT/prod/releases/$BUILD_NUMBER"
                dev_release="$ADMIN_ROOT/dev/releases/$BUILD_NUMBER"
                legacy_previous=$(readlink -f "$ADMIN_ROOT/current" || true)
                prod_previous=$(readlink -f "$ADMIN_ROOT/prod/current" || printf '%s' "$legacy_previous")
                dev_previous=$(readlink -f "$ADMIN_ROOT/dev/current" || true)
                mkdir -p "$prod_release" "$dev_release"
                cp -R frontend/admin/dist-prod/. "$prod_release/"
                cp -R frontend/admin/dist-dev/. "$dev_release/"
                ln -sfn "$prod_release" "$ADMIN_ROOT/prod/.current-next-$BUILD_NUMBER"
                ln -sfn "$dev_release" "$ADMIN_ROOT/dev/.current-next-$BUILD_NUMBER"
                mv -Tf "$ADMIN_ROOT/prod/.current-next-$BUILD_NUMBER" "$ADMIN_ROOT/prod/current"
                mv -Tf "$ADMIN_ROOT/dev/.current-next-$BUILD_NUMBER" "$ADMIN_ROOT/dev/current"
                ln -sfn "$prod_release" "$ADMIN_ROOT/.current-next-$BUILD_NUMBER"
                mv -Tf "$ADMIN_ROOT/.current-next-$BUILD_NUMBER" "$ADMIN_ROOT/current"
                if ! sudo /usr/sbin/nginx -t || ! sudo /usr/bin/systemctl reload nginx || ! curl -fsS "$ADMIN_PROD_HOST/" > /dev/null || ! curl -fsS "$ADMIN_DEV_HOST/" > /dev/null; then
                  if [ -n "$prod_previous" ]; then ln -sfn "$prod_previous" "$ADMIN_ROOT/prod/.current-rollback-$BUILD_NUMBER"; mv -Tf "$ADMIN_ROOT/prod/.current-rollback-$BUILD_NUMBER" "$ADMIN_ROOT/prod/current"; fi
                  if [ -n "$dev_previous" ]; then ln -sfn "$dev_previous" "$ADMIN_ROOT/dev/.current-rollback-$BUILD_NUMBER"; mv -Tf "$ADMIN_ROOT/dev/.current-rollback-$BUILD_NUMBER" "$ADMIN_ROOT/dev/current"; fi
                  if [ -n "$legacy_previous" ]; then ln -sfn "$legacy_previous" "$ADMIN_ROOT/.current-rollback-$BUILD_NUMBER"; mv -Tf "$ADMIN_ROOT/.current-rollback-$BUILD_NUMBER" "$ADMIN_ROOT/current"; fi
                  sudo /usr/sbin/nginx -t && sudo /usr/bin/systemctl reload nginx
                  exit 1
                fi
                '''
            }
        }
    }
}
