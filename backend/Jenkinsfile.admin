pipeline {
    agent any

    environment {
        ADMIN_ROOT = '/var/www/wecandoit-admin'
        ADMIN_HOST = 'https://i15a506.p.ssafy.io/admin-ui/'
    }

    stages {
        stage('Check Admin Changes') {
            steps {
                script {
                    def changedFiles = sh(script: 'git diff --name-only HEAD~1 HEAD || echo frontend/admin/', returnStdout: true).trim()
                    if (!changedFiles.split('\\n').any { it.startsWith('frontend/admin/') }) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No admin deployment changes.')
                    }
                }
            }
        }

        stage('Build Admin') {
            steps {
                dir('frontend/admin') {
                    sh '''
                    if ! command -v node >/dev/null 2>&1; then
                        NODE_VERSION=22.16.0
                        NODE_DIRECTORY=".node-v${NODE_VERSION}"
                        if [ ! -x "${NODE_DIRECTORY}/bin/node" ]; then
                            rm -rf "${NODE_DIRECTORY}"
                            mkdir -p "${NODE_DIRECTORY}"
                            curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
                              | tar -xz --strip-components=1 -C "${NODE_DIRECTORY}"
                        fi
                        export PATH="$(pwd)/${NODE_DIRECTORY}/bin:${PATH}"
                    fi
                    node --version
                    npm ci
                    npm run lint
                    VITE_API_ENV=prod VITE_API_BASE_URL=https://i15a506.p.ssafy.io npm run build
                    '''
                }
            }
        }

        stage('Release Admin') {
            steps {
                sh '''
                release="$ADMIN_ROOT/releases/$BUILD_NUMBER"
                previous=$(readlink -f "$ADMIN_ROOT/current" || true)
                next="$ADMIN_ROOT/.current-next-$BUILD_NUMBER"
                sudo mkdir -p "$release"
                sudo cp -R frontend/admin/dist/. "$release/"
                sudo ln -sfn "$release" "$next"
                sudo mv -Tf "$next" "$ADMIN_ROOT/current"
                if ! sudo nginx -t || ! sudo systemctl reload nginx || ! curl -fsS "$ADMIN_HOST/" > /dev/null; then
                  if [ -n "$previous" ]; then
                    rollback="$ADMIN_ROOT/.current-rollback-$BUILD_NUMBER"
                    sudo ln -sfn "$previous" "$rollback"
                    sudo mv -Tf "$rollback" "$ADMIN_ROOT/current"
                    sudo nginx -t && sudo systemctl reload nginx
                  fi
                  exit 1
                fi
                '''
            }
        }
    }
}
