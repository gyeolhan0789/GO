pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RESET_DEV_DB',
            defaultValue: false,
            description: 'Recreate the dev database and load scenario seed data.'
        )
    }

    environment {
        COMPOSE_FILE = 'docker-compose.dev.yml'
        SERVICE_NAME = 'backend'
    }

    stages {
        stage('Check Backend Changes') {
            steps {
                script {
                    if (params.RESET_DEV_DB) {
                        echo 'RESET_DEV_DB=true. Continue without backend change detection.'
                        return
                    }

                    def changedFiles = sh(
                        script: '''
                        if git rev-parse HEAD~1 >/dev/null 2>&1; then
                          git diff --name-only HEAD~1 HEAD
                        else
                          echo "backend/"
                        fi
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def hasBackendChanges = changedFiles
                        .split('\\n')
                        .any { it.startsWith('backend/') }

                    if (!hasBackendChanges) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No backend changes. Skip backend development CD.')
                    }
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    sh '''
                    chmod +x gradlew
                    ./gradlew clean bootJar -x test
                    '''
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'dev-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'dev-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'dev-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        script {
                            if (!params.RESET_DEV_DB) {
                                deployBackend('validate', 'never', false)
                                return
                            }

                            try {
                                sh '''
                                docker compose -f $COMPOSE_FILE up -d mysql redis
                                for i in $(seq 1 30); do
                                  if docker exec wecandoit-mysql-dev mysqladmin ping -h localhost -uroot -p"$DB_ROOT_PASSWORD" --silent; then
                                    break
                                  fi
                                  if [ "$i" = 30 ]; then
                                    echo "mysql did not become ready in time" >&2
                                    exit 1
                                  fi
                                  sleep 2
                                done
                                '''
                                sh 'docker compose -f $COMPOSE_FILE stop $SERVICE_NAME'
                                sh 'docker exec wecandoit-redis-dev redis-cli FLUSHDB'
                                sh '''
                                docker exec wecandoit-mysql-dev mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
                                  DROP DATABASE IF EXISTS wecandoit;
                                  CREATE DATABASE wecandoit CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
                                  GRANT ALL PRIVILEGES ON wecandoit.* TO 'wecandoit'@'%';
                                  FLUSH PRIVILEGES;
                                "
                                '''
                                deployBackend('validate', 'always', true)
                                waitForHealth('seed initialization')
                            } finally {
                                deployBackend('validate', 'never', true)
                                waitForHealth('safe configuration restore')
                            }
                        }
                    }
                }
            }
        }

        stage('Check Deploy') {
            steps {
                dir('backend') {
                    script {
                        waitForHealth('final deployment')
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Backend development CD completed successfully.'
        }
        failure {
            echo 'Backend development CD failed or skipped. Check Console Output.'
        }
    }
}

def deployBackend(String ddlAuto, String sqlInitMode, boolean forceRecreate) {
    withEnv([
        "DEV_DDL_AUTO=${ddlAuto}",
        "DEV_SQL_INIT_MODE=${sqlInitMode}"
    ]) {
        String recreateOption = forceRecreate ? '--force-recreate' : ''
        sh "docker compose -f ${env.COMPOSE_FILE} up -d --build ${recreateOption} ${env.SERVICE_NAME}"
    }
}

def waitForHealth(String phase) {
    // Jenkins는 컨테이너로 실행되어 호스트 loopback에 도달하지 못하므로(docker-outside-of-docker),
    // URL 기반 헬스체크 대신 docker 소켓으로 컨테이너 자체의 헬스 상태를 조회한다. 배포가 컨테이너를
    // 재생성하므로 이름이 아니라 배포 직후의 ID로 조회해 이전 컨테이너의 stale healthy를 피한다.
    sh """
    docker ps
    CID=\$(docker compose -f \$COMPOSE_FILE ps -q \$SERVICE_NAME)
    for i in \$(seq 1 60); do
      STATUS=\$(docker inspect --format '{{.State.Health.Status}}' \$CID 2>/dev/null || echo "unknown")
      echo "${phase} health check attempt \$i/60 status: \$STATUS"

      if [ "\$STATUS" = "healthy" ]; then
        exit 0
      fi

      sleep 2
    done

    echo "${phase} health check failed with status \$STATUS"
    exit 1
    """
}
