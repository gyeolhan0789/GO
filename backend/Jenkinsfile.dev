pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RESET_DEV_DB',
            defaultValue: false,
            description: 'Recreate the dev database and load scenario seed data.'
        )
    }

    environment {
        COMPOSE_FILE = 'docker-compose.dev.yml'
        SERVICE_NAME = 'backend'
        HEALTH_CHECK_URL = 'https://i15a506.p.ssafy.io/dev/actuator/health'
    }

    stages {
        stage('Check Backend Changes') {
            steps {
                script {
                    if (params.RESET_DEV_DB) {
                        echo 'RESET_DEV_DB=true. Continue without backend change detection.'
                        return
                    }

                    def changedFiles = sh(
                        script: '''
                        if git rev-parse HEAD~1 >/dev/null 2>&1; then
                          git diff --name-only HEAD~1 HEAD
                        else
                          echo "backend/"
                        fi
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    def hasBackendChanges = changedFiles
                        .split('\\n')
                        .any { it.startsWith('backend/') }

                    if (!hasBackendChanges) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No backend changes. Skip backend development CD.')
                    }
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('backend') {
                    sh '''
                    chmod +x gradlew
                    ./gradlew clean bootJar -x test
                    '''
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                dir('backend') {
                    withCredentials([
                        string(credentialsId: 'dev-db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'dev-db-root-password', variable: 'DB_ROOT_PASSWORD'),
                        string(credentialsId: 'dev-jwt-secret', variable: 'JWT_SECRET')
                    ]) {
                        script {
                            if (!params.RESET_DEV_DB) {
                                deployBackend('update', 'never', false)
                                return
                            }

                            try {
                                sh 'docker compose -f $COMPOSE_FILE up -d mysql redis'
                                sh 'docker compose -f $COMPOSE_FILE stop $SERVICE_NAME'
                                sh 'docker exec wecandoit-redis-dev redis-cli FLUSHDB'
                                deployBackend('create', 'always', true)
                                waitForHealth('seed initialization')
                            } finally {
                                deployBackend('update', 'never', true)
                                waitForHealth('safe configuration restore')
                            }
                        }
                    }
                }
            }
        }

        stage('Check Deploy') {
            steps {
                script {
                    waitForHealth('final deployment')
                }
            }
        }
    }

    post {
        success {
            echo 'Backend development CD completed successfully.'
        }
        failure {
            echo 'Backend development CD failed or skipped. Check Console Output.'
        }
    }
}

def deployBackend(String ddlAuto, String sqlInitMode, boolean forceRecreate) {
    withEnv([
        "DEV_DDL_AUTO=${ddlAuto}",
        "DEV_SQL_INIT_MODE=${sqlInitMode}"
    ]) {
        String recreateOption = forceRecreate ? '--force-recreate' : ''
        sh "docker compose -f ${env.COMPOSE_FILE} up -d --build ${recreateOption} ${env.SERVICE_NAME}"
    }
}

def waitForHealth(String phase) {
    sh """
    docker ps
    for i in \$(seq 1 30); do
      STATUS=\$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 ${env.HEALTH_CHECK_URL} || echo "000")
      echo "${phase} health check attempt \$i/30 status: \$STATUS"

      if [ "\$STATUS" = "200" ]; then
        exit 0
      fi

      sleep 2
    done

    echo "${phase} health check failed with status \$STATUS"
    exit 1
    """
}
