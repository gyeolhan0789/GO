// docker.sock을 마운트하지 않으므로(C8) discovery.docker는 쓸 수 없다. /var/lib/docker/containers:ro
// 파일 경로만으로 컨테이너를 찾는다 — 그 결과 얻을 수 있는 라벨은 컨테이너 ID뿐이고, 사람이 읽는
// 컨테이너 이름(예: wecandoit-backend-stable)은 Docker API 없이는 알 수 없다. 이름까지 필요하면
// docker.sock을 마운트하거나(C8과 상충) config.v2.json을 별도로 읽는 스테이지가 필요하다 — 미구현.

local.file_match "docker_containers" {
    path_targets = [{
        __path__ = "/var/lib/docker/containers/*/*-json.log",
    }]
}

discovery.relabel "docker_containers" {
    targets = local.file_match.docker_containers.targets

    rule {
        source_labels = ["__path__"]
        regex         = ".*/([0-9a-f]{12})[0-9a-f]*/[0-9a-f]+-json\\.log"
        target_label  = "container_id"
    }
}

loki.source.file "docker_containers" {
    targets    = discovery.relabel.docker_containers.output
    forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
    forward_to = [loki.write.default.receiver]

    // Docker json-file 드라이버가 쓰는 {"log":"...","stream":"...","time":"..."} 한 줄짜리 포맷을 해석한다.
    stage.docker {}

    stage.static_labels {
        values = {
            env = "prod",
        }
    }
}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}
