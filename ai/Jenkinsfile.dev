pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Check AI Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD || echo ai/',
                        returnStdout: true
                    ).trim()

                    if (!changedFiles.split('\\n').any { it.startsWith('ai/') }) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No AI changes. Skip AI development CD.')
                    }
                }
            }
        }

        stage('Deploy Notice') {
            steps {
                echo 'AI dev server now runs on a developer workstation via SSH reverse tunnel to 127.0.0.1:8000. Container build/deploy is disabled here.'
            }
        }
    }
}
