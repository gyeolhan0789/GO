<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 미션 사진 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 걸음 수(신체 활동) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 알림 수신 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 위치 (산책 경로 지도 표시) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 잠금화면 실시간 통계 상주 알림용 포그라운드 서비스 (서비스 구현은 이후) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- 카메라 없는 기기도 설치 허용 -->
    <uses-feature
      android:name="android.hardware.camera"
      android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- TODO: android/local.properties에 MAPS_API_KEY=발급받은키 를 추가해야
           실제 지도가 뜬다(안 넣으면 회색 화면). 키 발급: Google Cloud Console
           > APIs & Services > Maps SDK for Android 사용 설정 후 API 키 생성. -->
      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="${MAPS_API_KEY}" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- 카카오 로그인이 카카오톡/브라우저에서 돌아올 때 받는 리다이렉트 창구.
           스킴의 키는 app/build.gradle이 local.properties의
           KAKAO_NATIVE_APP_KEY에서 채운다(없으면 빈 값이라 로그인만 실패한다). -->
      <activity
        android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
              android:host="oauth"
              android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
        </intent-filter>
      </activity>
    </application>
</manifest>
